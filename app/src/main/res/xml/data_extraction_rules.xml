<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="gdl_cookie_prefs.xml"/>
        <exclude domain="file" path="cookies.txt"/>
        <exclude domain="root" path="app_webview"/>
        <exclude domain="file" path="archive.sqlite3-wal"/>
        <exclude domain="file" path="archive.sqlite3-shm"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="gdl_cookie_prefs.xml"/>
        <exclude domain="file" path="cookies.txt"/>
        <exclude domain="root" path="app_webview"/>
        <exclude domain="file" path="archive.sqlite3-wal"/>
        <exclude domain="file" path="archive.sqlite3-shm"/>
    </device-transfer>
</data-extraction-rules>
